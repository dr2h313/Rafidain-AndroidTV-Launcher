<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: glowing cyan with gold border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#E60284C7" />
            <corners android:radius="14dp" />
            <stroke android:width="2.5dp" android:color="#FFFBBF24" />
        </shape>
    </item>
    <!-- Selected state: amber gold glow -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#B3D97706" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#FFFDE047" />
        </shape>
    </item>
    <!-- Normal state: frosted acrylic glass -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26334155" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
        </shape>
    </item>
</selector>
