<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream): clock, date and daily supplication drifting across black screen -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- The ambient glow background -->
    <ImageView
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <!-- Drifting Container (prevent burn-in) -->
    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:maxWidth="640dp">

        <!-- Time & Period -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#E6FFFFFF"
                android:textSize="96sp"
                android:fontFamily="@string/font_extralight"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#FFFBBF24"
                android:textSize="22sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />
        </LinearLayout>

        <!-- Date -->
        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="2dp"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:textColor="#8CFFFFFF"
            android:textSize="17sp"
            android:fontFamily="@string/font_regular"
            android:letterSpacing="0.08"
            android:textAllCaps="true" />

        <!-- Spiritual Card: Daily Dua & Ahlulbayt Hadith -->
        <LinearLayout
            android:id="@+id/dreamSpiritualCard"
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_spiritual_card"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="18dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp">

            <!-- Dua Header -->
            <TextView
                android:id="@+id/dreamDuaTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🕌 دعاء اليوم المبارك"
                android:textColor="#FFFBBF24"
                android:textSize="17sp"
                android:fontFamily="@string/font_medium" />

            <!-- Dua Excerpt Text -->
            <TextView
                android:id="@+id/dreamDuaContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ... اللَّهُمَّ اجْعَلْ أَوَّلَ يَوْمِي هَذَا صَلاحاً، وَأَوْسَطَهُ فَلاحاً، وَآخِرَهُ نَجَاحاً."
                android:textColor="#FFF"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp"
                android:maxLines="4"
                android:ellipsize="end" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"
                android:background="#33F59E0B" />

            <!-- Hadith Text & Source -->
            <TextView
                android:id="@+id/dreamHadith"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📖 قال رسول الله (ص): «حُسْنُ الْخُلُقِ يُثْبِتُ الْمَوَدَّةَ وَيُهْدِمُ الْعَدَاوَةَ» (بحار الأنوار)"
                android:textColor="#FF38BDF8"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Prayer & Weather Info Footer -->
        <TextView
            android:id="@+id/dreamInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/pill_bg"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="🕌 مواقيت الصلاة وطقس البصرة · شط العرب والنشوة"
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:fontFamily="@string/font_regular" />
    </LinearLayout>

</FrameLayout>
