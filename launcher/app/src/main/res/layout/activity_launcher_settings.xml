<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF070B14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingEnd="64dp"
        android:paddingTop="32dp"
        android:paddingBottom="48dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚙️ إعدادات واجهة التلفاز الذكية"
                android:textColor="#FFFBBF24"
                android:textSize="32sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CleanTV Iraq Suite · إصدار رافدين"
                android:textColor="#80FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- SECTION 1: App Grid & Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_settings_section"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📐 تخطيط الشاشة وتوزيع التطبيقات"
                android:textColor="#FF38BDF8"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/reorderChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="16dp"
                android:text="@string/reorder"
                android:visibility="gone" />

            <!-- Columns Row -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/columns_label"
                android:textColor="#E2E8F0"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4 أعمدة" />
                <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5 أعمدة" />
                <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6 أعمدة" />
                <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7 أعمدة" />
            </LinearLayout>

            <!-- Rows Below Dock -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/rows_below_dock_label"
                android:textColor="#E2E8F0"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="بدون صفوف (0)" />
                <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="صف واحد (1)" />
                <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="صفين (2)" />
                <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3 صفوف" />
            </LinearLayout>
        </LinearLayout>

        <!-- SECTION 2: Appearance & Translucency -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_settings_section"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎨 المظهر والخلفيات والشفافية"
                android:textColor="#FF38BDF8"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium" />

            <!-- Wallpaper Choice -->
            <TextView
                android:id="@+id/wallpaperChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="16dp" />

            <!-- Dock Opacity -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/dock_opacity_label"
                android:textColor="#E2E8F0"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="معتم 100%" />
                <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="شبه شفاف 70%" />
                <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="زجاجي 50%" />
                <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:text="شفاف جداً 30%" />
            </LinearLayout>

            <!-- Animations -->
            <TextView
                android:id="@+id/animationsChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/advancedChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/advanced_effects_warning"
                android:textColor="#FF94A3B8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- SECTION 3: Time & Clock Format -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_settings_section"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏰ توقيت الساعة وشاشة التوقف"
                android:textColor="#FF38BDF8"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/dream_name"
                android:textColor="#E2E8F0"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/clockSystem" style="@style/SettingsColumnChoice" android:text="@string/clock_format_system" />
                <TextView android:id="@+id/clock12" style="@style/SettingsColumnChoice" android:text="@string/clock_format_12" />
                <TextView android:id="@+id/clock24" style="@style/SettingsColumnChoice" android:text="@string/clock_format_24" />
            </LinearLayout>

            <TextView
                android:id="@+id/followThemeChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="16dp"
                android:text="@string/follow_theme" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/follow_theme_hint"
                android:textColor="#FF94A3B8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- SECTION 4: System Integration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_settings_section"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛠️ إعدادات التلفاز والنظام"
                android:textColor="#FF38BDF8"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/openOnStartChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/defaultHomeChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="16dp"
                android:text="@string/home_settings" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/home_settings_help"
                android:textColor="#FF94A3B8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvSettingsChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="14dp"
                android:text="@string/tv_settings" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
